# .env.example — Blinkit Discovery Engine
# Copy this file to .env and fill in your API keys.
# Reddit does NOT require API keys — uses keyless community mirrors.

GROQ_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
ADMIN_INGEST_TOKEN=          # Secures POST /api/ingest on Railway

# Optional: Override default data paths
# DATA_DIR=./data
# CHROMA_DIR=./data/chroma_snapshot
